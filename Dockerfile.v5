FROM node:22-slim

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v5.0.0 https://github.com/jackyzha0/quartz.git /quartz

WORKDIR /quartz
RUN npm ci

# v5 fetches plugins as 42 separate git repositories. They must be present
# before `quartz build` runs, or esbuild fails to resolve ".quartz/plugins"
# from quartz/components/Head.tsx.
#
# `plugin restore` installs the exact commits pinned in quartz.lock.json.
# `plugin install` and `plugin update` do not pin, so prefer restore.
#
# This takes roughly 10 minutes and produces about 320MB. It prints nothing at
# all until it completes -- that is output buffering inside the build layer,
# not a hang. Because quartz.lock.json is baked into the cloned tag above, this
# layer is cached and only re-runs when the base image or the pinned Quartz
# version changes.
RUN npx quartz plugin restore

EXPOSE 8082
